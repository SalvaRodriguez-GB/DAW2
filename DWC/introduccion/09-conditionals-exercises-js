// 3. Verifica si un número es positivo, negativo o cero e imprime un mensaje

let anyNumber = -1

switch (true) {
    case anyNumber == 0: {
        console.log("Es 0")
        break;
    }
    case anyNumber > 0: {
        console.log("Es positivo")
        break;
    }
    case anyNumber < 0: {
        console.log("Es negativo")
        break;
    }

    default: {
        console.log("Eso no es un número, perro")
    }
}

